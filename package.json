{
  "name": "magpie-remote-bridge",
  "displayName": "Magpie Remote Bridge",
  "description": "%extension.description%",
  "version": "0.3.3",
  "publisher": "wkoa",
  "license": "MIT",
  "author": "wkoa",
  "keywords": [
    "magpie",
    "remote-ssh",
    "ai",
    "agent",
    "gateway",
    "claude",
    "codex",
    "reverse-tunnel"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#10283f",
    "theme": "dark"
  },
  "qna": "https://github.com/wkoa/magpie-remote-bridge/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/wkoa/magpie-remote-bridge.git"
  },
  "homepage": "https://github.com/wkoa/magpie-remote-bridge#readme",
  "bugs": {
    "url": "https://github.com/wkoa/magpie-remote-bridge/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "test:codex-sidebar": "node scripts/verify-codex-sidebar.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "magpieBridge.connect",
        "title": "%command.connect%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.disconnect",
        "title": "%command.disconnect%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.changeHost",
        "title": "%command.changeHost%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.terminal",
        "title": "%command.terminal%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.claude",
        "title": "%command.claude%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.codex",
        "title": "%command.codex%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.codexSidebar",
        "title": "%command.codexSidebar%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.restoreCodex",
        "title": "%command.restoreCodex%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.model",
        "title": "%command.model%"
      },
      {
        "command": "magpieBridge.diagnose",
        "title": "%command.diagnose%"
      },
      {
        "command": "magpieBridge.copyConnection",
        "title": "%command.copyConnection%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.key",
        "title": "%command.key%"
      },
      {
        "command": "magpieBridge.logs",
        "title": "%command.logs%"
      },
      {
        "command": "magpieBridge.menu",
        "title": "%command.menu%",
        "enablement": "remoteName == ssh-remote && isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "magpieBridge.settings",
        "title": "%command.settings%"
      },
      {
        "command": "magpieBridge.gettingStarted",
        "title": "%command.gettingStarted%"
      }
    ],
    "configuration": {
      "title": "Magpie Remote Bridge",
      "properties": {
        "magpieBridge.sshHost": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%setting.sshHost%"
        },
        "magpieBridge.gatewayPort": {
          "type": "integer",
          "default": 3425,
          "minimum": 1,
          "maximum": 65535,
          "scope": "application",
          "description": "%setting.gatewayPort%"
        },
        "magpieBridge.remotePort": {
          "type": "integer",
          "default": 13425,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "%setting.remotePort%"
        },
        "magpieBridge.sshPath": {
          "type": "string",
          "default": "ssh",
          "scope": "application",
          "description": "%setting.sshPath%"
        },
        "magpieBridge.sshConfigFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%setting.sshConfigFile%"
        },
        "magpieBridge.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%setting.model%"
        },
        "magpieBridge.autoConnect": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.autoConnect%"
        },
        "magpieBridge.autoReconnect": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.autoReconnect%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "magpieBridge.connect",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.disconnect",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.changeHost",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.terminal",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.claude",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.codex",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.codexSidebar",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.restoreCodex",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.copyConnection",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "magpieBridge.menu",
          "when": "remoteName == ssh-remote"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "magpieBridge.setup",
        "title": "%setup.title%",
        "description": "%setup.description%",
        "steps": [
          {
            "id": "gateway",
            "title": "%setup.gateway.title%",
            "description": "%setup.gateway.description%",
            "completionEvents": [
              "onCommand:magpieBridge.diagnose"
            ],
            "media": {
              "image": "resources/icon.png",
              "altText": "Magpie Remote Bridge"
            }
          },
          {
            "id": "connect",
            "title": "%setup.connect.title%",
            "description": "%setup.connect.description%",
            "completionEvents": [
              "onCommand:magpieBridge.connect"
            ],
            "media": {
              "image": "resources/icon.png",
              "altText": "Magpie Remote Bridge"
            }
          },
          {
            "id": "agent",
            "title": "%setup.agent.title%",
            "description": "%setup.agent.description%",
            "completionEvents": [
              "onCommand:magpieBridge.claude",
              "onCommand:magpieBridge.codex"
            ],
            "media": {
              "image": "resources/icon.png",
              "altText": "Magpie Remote Bridge"
            }
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "l10n": "./l10n"
}
